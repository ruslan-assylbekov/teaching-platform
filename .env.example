# Copy to .env and fill in real values. Never commit .env.

# Postgres — used by docker-compose to configure the postgres service, and
# by the app (via DATABASE_URL) to connect. When running outside Docker
# point DATABASE_URL at a Postgres reachable from your machine; inside
# Docker Compose, docker-compose.yml overrides DATABASE_URL to point at the
# postgres service by name, so the value below is only used for local
# (non-containerized) development.
POSTGRES_DB=jonathan_math
POSTGRES_USER=jonathan_math
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://jonathan_math:change-me@localhost:5432/jonathan_math

# Session token signing (jose). Generate with e.g. `openssl rand -base64 48`.
SESSION_SECRET=change-me-to-a-long-random-string

# Default IANA timezone for newly created class_slots (design spec §7.6 —
# Asia/Almaty is UTC+5 with no DST transitions). Individual slots may still
# carry a different timezone; this is only the default offered at creation.
DEFAULT_TIMEZONE=Asia/Almaty

# One-time seed teacher account. scripts/seed-teacher.ts reads these and
# refuses to run again once any teacher row exists (design spec §5.5).
TEACHER_SEED_USERNAME=teacher
TEACHER_SEED_PASSWORD=change-me

# Public hostname Caddy serves, including scheme. Plain http://localhost
# during development — no domain is registered yet, so HTTPS is not
# possible (design spec §8). Once a domain exists, switch this to the bare
# domain with no scheme (e.g. math.example.com) and reload Caddy; it will
# provision HTTPS automatically. This is the one-line switch §8 describes.
APP_HOSTNAME=http://localhost

# GCS bucket for nightly backups (scripts/backup.ts, design spec §3.1).
# Optional — the app itself runs fine without it; only the backup script
# needs it, and fails clearly if it's missing when actually invoked.
# Authenticates via Application Default Credentials (the GCE VM's attached
# service account in production; `gcloud auth application-default login`
# locally), not a key file here.
GCS_BUCKET=
