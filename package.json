{
  "name": "jonathan-math",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "migrate": "node-pg-migrate --migrations-dir db/migrations --migration-file-language sql",
    "seed:teacher": "node --env-file-if-exists=.env scripts/seed-teacher.ts",
    "backup": "node --env-file-if-exists=.env scripts/backup.ts"
  },
  "dependencies": {
    "@google-cloud/storage": "^8.0.1",
    "@node-rs/argon2": "2.1.0",
    "jose": "6.2.9",
    "luxon": "3.7.2",
    "next": "16.3.1",
    "next-intl": "4.13.6",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/luxon": "^3",
    "@types/node": "24.x",
    "@types/pg": "^8",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "node-pg-migrate": "9.0.0",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
